# Winged — secrets (app runs locally without these; Auth/DB need Supabase free tier)

# --- Supabase (free Postgres + Auth) — see docs/supabase-setup.md ---
# Dashboard: https://supabase.com/dashboard/new
# CLI token: https://supabase.com/dashboard/account/tokens  → SUPABASE_ACCESS_TOKEN
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server admin (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: for `npx supabase login --token` / db push from CI/agents
# SUPABASE_ACCESS_TOKEN=

# Public site URL for OAuth redirects (production)
# NEXT_PUBLIC_SITE_URL=https://winged-app.vercel.app
# Redirect allowlist in Supabase: {SITE_URL}/auth/callback

# Google: enable in Supabase → Authentication → Providers → Google
#   (paste Google Cloud OAuth Client ID + Secret there — not only in .env)

# Apple: enable in Supabase → Providers → Apple (Services ID, key, team)
# Phone OTP: enable Phone provider + Twilio (or Supabase SMS)

# --- Stripe (Date Pass Checkout + Connect withdraw) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_CONNECT_CLIENT_ID=

# --- Optional places upgrade (Nominatim works with no key) ---
# NEXT_PUBLIC_MAPBOX_TOKEN=
