# Winged — secrets (app runs locally without these; OAuth/Stripe need them)

# --- Supabase Auth (required for Google / Apple / Phone OTP) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server admin
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL for OAuth redirects (production)
# NEXT_PUBLIC_SITE_URL=https://winged-app.vercel.app
# Redirect allowlist in Supabase: {SITE_URL}/auth/callback

# Google: enable in Supabase → Authentication → Providers → Google
#   (paste Google Cloud OAuth Client ID + Secret there — not only in .env)

# Apple: enable in Supabase → Providers → Apple (Services ID, key, team)
# Phone OTP: enable Phone provider + Twilio (or Supabase SMS)

# --- Stripe (Date Pass Checkout + Connect withdraw) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_CONNECT_CLIENT_ID=

# --- Optional places upgrade (Nominatim works with no key) ---
# NEXT_PUBLIC_MAPBOX_TOKEN=
